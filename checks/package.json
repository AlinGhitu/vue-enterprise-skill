{
  "name": "vue-enterprise-skill-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "snippets": "node scripts/extract-snippets.mjs",
    "skill": "node scripts/check-skill.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "check": "node scripts/check-skill.mjs && node scripts/extract-snippets.mjs --check && vue-tsc --noEmit && eslint --max-warnings 0 . && vitest run"
  },
  "dependencies": {
    "@pinia/colada": "^1.4.5",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.14",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/trusted-types": "^2.0.7",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  }
}
